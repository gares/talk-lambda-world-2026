data tm.
symb app : tm -> tm -> tm.
symb lam : (tm -> tm) -> tm.

main :- F = (x\x), F 1 = 1.
% hidden: examples
%main :- F = (x\x + 1), F 1 = 2. % its syntax
%main :- F = (x\x + 1), R is F 1, R = 2. % its syntax
%main :- Fst = (lam x\ lam y\ x), print Fst.
% hidden-end

symb c : tm. % dummy

func depth tm -> int.
depth (app H A) N :-
  depth H N1, depth A N2, N is 1 + max N1 N2.
depth (lam F) N :-
  depth (F c) N1,
  N is 1 + N1.
depth c 0.

