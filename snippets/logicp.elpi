/*#region types*/
data person.
symb mallory, bob, alice : person.

pred age -> person, int.

age mallory 23.
age bob 23.
age alice 20.

main :-
  age P A, print "I picked P =" P,
  age Q A, print "I picked Q =" Q,
  not(P = Q),
  print "the last choice worked!",
  print P "and" Q "are" A "years old".
/*#endregion*/
