/*#region symbs*/
data tm.
symb app : tm -> tm -> tm.
symb lam : (tm -> tm) -> tm.

data ty.
symb arr : ty -> ty -> ty.
/*#endregion*/
symb c : tm.
symb d : tm.

/*#region of*/
func of tm -> ty.
of (app H A) T :-
  of H (arr S T), of A S.
of (lam F) (arr S T) :-
  pi x\ of x S ==> of (F x) T.
/*#endregion*/

namespace s1 {
/*#region of1*/
func of tm -> ty.
of c S0.        % assumed: pi x\ ... ==>
of (app H A) T :-
  of H (arr S T), of A S.
of (lam F) (arr S T) :-
  pi x\ of x S ==> of (F x) T.
/*#endregion*/
}
namespace s2 {

/*#region of2*/
func of tm -> ty.
of d S1.        % assumed: pi x\ ... ==>
of c S0.        % assumed: pi x\ ... ==>
of (app H A) T :-
  of H (arr S T), of A S.
of (lam F) (arr S T) :-
  pi x\ of x S ==> of (F x) T.
/*#endregion*/
}

func suspend (func), any.
suspend X L :- declare_constraint X [L].
/*#region cst*/
of (uvar as E) T :-
  suspend (of E T) E.
/*#endregion*/

/*#region chr*/
constraint of {
    rule (of X T1) \ (of X T2) <=> (T1 = T2).
}
/*#endregion*/