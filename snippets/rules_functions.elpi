data tree A.
symb leaf : tree A.
symb node : A -> tree A -> tree A -> tree A.

func depth tree A -> int.
depth leaf 0.
depth (node _ L R) N :-
  depth L N1, depth R N2, N is 1 + max N1 N2.

main :-
  depth (node 1 (node 2 leaf leaf) leaf) D,
  print D.
