{
  // Don't spend inotify watches (and search time) on dependencies and on
  // what Slidev generates: `make html` output, `make slides.pdf` temporaries,
  // and the js_of_ocaml build of the Elpi language server.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/html/**": true,
    "**/slides.png/**": true,
    "**/dist/**": true,
    "**/.slidev/**": true,
    "public/elpi-lsp-web.js": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "html/**": true,
    "slides.png/**": true,
    "public/elpi-lsp-web.js": true
  }
}
